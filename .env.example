# =============================================================================
# agentic-workflow — environment template
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
# =============================================================================

# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #
AWF_ENVIRONMENT=development           # development | staging | production
AWF_SERVICE_NAME=agentic-workflow     # Logical name attached to every log record
AWF_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
AWF_LOG_FORMAT=console                # console | json
AWF_GRAPH_NAME=pr_review_workflow     # Logical graph name used as thread namespace
AWF_MAX_ITERATIONS=6                  # Hard cap on the agent feedback loop
AWF_NODE_TIMEOUT_SECONDS=120          # Per-node wall-clock budget
AWF_RUN_TIMEOUT_SECONDS=900           # Per-run wall-clock budget (0 = unlimited)
AWF_MAX_PARALLEL_RUNS=8              # In-process concurrency ceiling
AWF_STATE_RETENTION_DAYS=30           # TTL applied by the checkpoint janitor

# --------------------------------------------------------------------------- #
# LLM provider
#   echo  -> deterministic offline provider (default, ideal for tests/CI)
#   openai -> any OpenAI-compatible endpoint (OpenAI, Azure, vLLM, Ollama, ...)
# --------------------------------------------------------------------------- #
AWF_LLM_PROVIDER=echo
AWF_LLM_MODEL=gpt-4o-mini
AWF_LLM_BASE_URL=https://api.openai.com/v1
AWF_LLM_TEMPERATURE=0.0
AWF_LLM_MAX_TOKENS=2048
AWF_LLM_TIMEOUT_SECONDS=60
AWF_LLM_MAX_RETRIES=3
AWF_LLM_MAX_CONCURRENCY=8
# Ceiling on the total LLM tokens ONE run may spend, across every drive of that
# run (start, each resume). It is what bounds cost per request, since
# AWF_API_RATE_LIMIT_PER_MINUTE counts requests and one request was measured
# from 6,472 tokens to 4,060,022 at the 200-file wire limit. 0 disables it.
# The default admits a 20-file diff (328k measured) and refuses a payload that
# is a mistake. A refused run stops at the call that would cross the ceiling;
# what it already spent is still charged and still readable at
# GET /v1/runs/{id}/usage.
AWF_LLM_TOKEN_BUDGET_PER_RUN=500000
# Single secret. Prefer a real secret manager in production.
AWF_LLM_API_KEY=                       # noqa: S105 - template only

# --------------------------------------------------------------------------- #
# PostgreSQL (durable checkpointer + run registry)
# --------------------------------------------------------------------------- #
AWF_POSTGRES_ENABLED=false
AWF_POSTGRES_DSN=postgresql://agentic:agentic@localhost:5432/agentic
AWF_POSTGRES_POOL_MIN_SIZE=1
AWF_POSTGRES_POOL_MAX_SIZE=10
AWF_POSTGRES_POOL_TIMEOUT_SECONDS=30
AWF_POSTGRES_STATEMENT_TIMEOUT_MS=30000
AWF_POSTGRES_SCHEMA=public               # Bare SQL identifier; applied as search_path
AWF_POSTGRES_AUTO_SETUP=true             # Create the schema and tables on boot
AWF_POSTGRES_SSLMODE=prefer
# Runs rehydrated into the registry on boot. Bounds the *listing* so a restart
# cannot stall on a large checkpoints table; every run stays readable, resumable
# and cancellable by id regardless of this number.
AWF_RECOVERY_MAX_RUNS=1000

# --------------------------------------------------------------------------- #
# API / control plane
# --------------------------------------------------------------------------- #
# The bind address is not a setting: this service is an ASGI application and
# uvicorn reads --host/--port from its own command line (see the Dockerfile).
# The published port is mapped on the compose side, via AWF_API_PORT.
AWF_API_ROOT_PATH=
# List fields are parsed as JSON by pydantic-settings — in dotenv files *and* in
# real environment variables. A bare `http://a,http://b` does not work.
AWF_API_CORS_ORIGINS=["http://localhost:3000"]
AWF_API_AUTH_ENABLED=false
AWF_API_AUTH_TOKEN=                     # noqa: S105 - template only
AWF_API_RATE_LIMIT_PER_MINUTE=120
# Rate limiting keys on the socket peer unless a trusted proxy overwrites this
# header. Leave false: X-Forwarded-For is caller-writable, so trusting it lets
# any client take a fresh budget per request.
AWF_API_TRUST_FORWARDED_FOR=false
AWF_API_DOCS_ENABLED=true             # Forced off when AWF_ENVIRONMENT=production
AWF_WS_HEARTBEAT_SECONDS=20
AWF_WS_SEND_TIMEOUT_SECONDS=10
# Observers on one run. Bounds a single run's fan-out so a busy dashboard cannot
# crowd out the operator watching a run parked on a human decision.
AWF_WS_MAX_CONNECTIONS_PER_RUN=16
# Observers across every run, wildcard stream included. The per-run cap counts
# one bucket and the bucket key is a run id the caller supplies, so this is the
# limit that actually bounds the process: one live socket costs ~39 KiB and one
# file descriptor. Must be >= the per-run cap. /metrics reports the current
# count as awf_events_subscribers next to this as awf_events_subscribers_max.
AWF_WS_MAX_CONNECTIONS_TOTAL=512

# --------------------------------------------------------------------------- #
# Human-in-the-Loop policy
# --------------------------------------------------------------------------- #
AWF_HITL_ENABLED=true
AWF_HITL_DEFAULT_TIMEOUT_SECONDS=86400 # 24h before an approval expires
AWF_HITL_REQUIRE_APPROVAL_BEFORE_APPLY=true
AWF_HITL_ESCALATION_THRESHOLD=0.7       # Confidence below this forces a human gate
AWF_HITL_ALLOW_EDIT=true                # Humans may rewrite agent output
AWF_HITL_ALLOW_REJECT=true
AWF_HITL_REQUIRE_SIGNATURE=true         # Decisions are signed & audit-logged
# Key that signs those decisions. Empty falls back to AWF_API_AUTH_TOKEN, and
# without either the decisions are recorded UNSIGNED and the API says so at boot.
# Generate one with: openssl rand -hex 32
AWF_HITL_SIGNING_SECRET=

# --------------------------------------------------------------------------- #
# Evaluation
# --------------------------------------------------------------------------- #
AWF_EVAL_PROVIDER=ragas                # native | ragas | deepeval
# Graded when `awf eval` runs without --dataset, which always wins.
AWF_EVAL_DATASET_PATH=evals/datasets/pr_review_golden.jsonl
# One threshold applies to every gated metric (1.00, per case), and `--gate`
# chooses whether the verdict covers the invariants only or all of them.
